DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/DATABASE
# required, at least 32 characters (the placeholder below is rejected at startup), e.g. python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
# comma-separated list of allowed front-end origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# optional: send an email to the ad owner for each application (nothing is sent when SMTP_HOST is empty)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@jobboard.example.com
# SMTP_STARTTLS=true

# rate limiting per client IP (<count>/<second|minute|hour|day>)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN=10/minute
# RATE_LIMIT_APPLY=20/hour
